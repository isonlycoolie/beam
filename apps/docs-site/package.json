{
  "name": "@beam/docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "postinstall": "fumadocs-mdx && node scripts/gen-ui-examples.mjs",
    "predev": "node scripts/gen-ui-examples.mjs && node scripts/gen-icon-index.mjs && node ../../packages/ui/scripts/build-registry.mjs public/r",
