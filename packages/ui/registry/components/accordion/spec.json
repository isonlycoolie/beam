{
  "name": "accordion",
  "title": "Accordion",
  "summary": "Sections that open one at a time.",
  "source": "shadcn/ui (MIT)",
  "use_when": [
    "Questions and answers, or settings groups people scan"
  ],
  "avoid_when": [
    "Content everyone needs: show it open"
  ],
  "props": {
    "type": "single | multiple",
    "collapsible": "boolean"
  },
  "variants": [
    "default"
  ],
  "styles": [
    "default"
  ],
  "composes_with": [],
  "copy": {
    "triggers": "Questions or nouns, parallel"
  },
  "states": [
    "closed",
    "open"
  ],
  "a11y": [
    "Buttons with aria-expanded (Radix)"
  ],
  "rules": [
    "copy.sibling-parity",
    "state.complete"
  ]
}
