{
  "name": "slider",
  "title": "Slider",
  "summary": "Picks a value along a range.",
  "source": "shadcn/ui (MIT)",
  "use_when": [
    "Approximate values where the range matters more than the number"
  ],
  "avoid_when": [
    "Exact amounts: use an Input"
  ],
  "props": {
    "value": "number[]",
    "min": "number",
    "max": "number",
    "step": "number"
  },
  "variants": [
    "default"
  ],
  "styles": [
    "default"
  ],
  "composes_with": [],
  "copy": {},
  "states": [
    "default",
    "focus",
    "disabled"
  ],
  "a11y": [
    "Label it; arrow keys move it (Radix)"
  ],
  "rules": [
    "state.complete"
  ]
}
