{
  "name": "toggle",
  "title": "Toggle",
  "summary": "A button that stays pressed or not.",
  "source": "shadcn/ui (MIT)",
  "use_when": [
    "One on/off option shown as a button, like a view filter"
  ],
  "avoid_when": [
    "A setting: use a Switch"
  ],
  "props": {
    "pressed": "boolean",
    "onPressedChange": "(pressed) => void"
  },
  "variants": [
    "default"
  ],
  "styles": [
    "default"
  ],
  "composes_with": [],
  "copy": {},
  "states": [
    "default",
    "on",
    "focus",
    "disabled"
  ],
  "a11y": [
    "aria-pressed is set (Radix)"
  ],
  "rules": [
    "state.complete"
  ],
  "sizes": [
    "sm",
    "md",
    "lg"
  ]
}
