{
  "name": "textarea",
  "title": "Textarea",
  "summary": "Multi-line text, styled like Input.",
  "source": "shadcn/ui (MIT)",
  "use_when": [
    "Free text longer than one line"
  ],
  "avoid_when": [
    "One short value: use an Input"
  ],
  "props": {
    "rows": "number",
    "placeholder": "string"
  },
  "variants": [
    "default"
  ],
  "styles": [
    "default"
  ],
  "composes_with": [],
  "copy": {
    "placeholder": "An example, never the label"
  },
  "states": [
    "default",
    "hover",
    "focus",
    "disabled"
  ],
  "a11y": [
    "Always has a visible Label"
  ],
  "rules": [
    "form.labels-visible",
    "state.complete"
  ]
}
