{
  "name": "input-group",
  "title": "Input Group",
  "summary": "An input with an icon, text or button attached.",
  "source": "shadcn/ui (MIT)",
  "use_when": [
    "An input with a unit, icon, prefix or inline action"
  ],
  "avoid_when": [
    "Two separate fields: use Field"
  ],
  "props": {},
  "variants": [
    "default"
  ],
  "styles": [
    "default"
  ],
  "composes_with": [],
  "copy": {
    "addon": "Units and short labels only"
  },
  "states": [
    "default",
    "hover",
    "focus",
    "disabled"
  ],
  "a11y": [
    "Label the input itself"
  ],
  "rules": [
    "form.labels-visible",
    "state.complete"
  ]
}
