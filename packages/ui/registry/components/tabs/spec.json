{
  "name": "tabs",
  "title": "Tabs",
  "summary": "Switches between views of the same thing.",
  "source": "shadcn/ui (MIT)",
  "use_when": [
    "Two to six views of the same object or page"
  ],
  "avoid_when": [
    "Steps in a sequence: use a stepper",
    "Navigation between pages: use links"
  ],
  "props": {
    "variant": "underline | segmented",
    "value": "string",
    "onValueChange": "(value) => void"
  },
  "variants": [
    "default",
    "segmented"
  ],
  "styles": [
    "default",
    "segmented"
  ],
  "composes_with": [],
  "copy": {
    "labels": "One or two words, sentence case"
  },
  "states": [
    "default",
    "hover",
    "focus",
    "disabled"
  ],
  "a11y": [
    "Arrow keys move between tabs (Radix)"
  ],
  "rules": [
    "copy.sibling-parity",
    "state.complete"
  ]
}
