{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["palettes/**/*.ts", "lib/**/*.ts", "icons/**/*.tsx", "registry/**/*.ts", "registry/**/*.tsx", "registry/**/*.json", "test/**/*.ts"]
}
