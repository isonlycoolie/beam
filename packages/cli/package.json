{
  "name": "usebeam",
  "version": "0.1.0",
  "description": "Local-first Figma design context bridge for coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "beam": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-cli-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isonlycoolie/beam.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/isonlycoolie/beam/issues"
  },
  "homepage": "https://github.com/isonlycoolie/beam#readme",
  "keywords": [
    "figma",
    "mcp",
    "cli",
    "design-to-code",
    "coding-agents"
  ],
  "dependencies": {
    "pixelmatch": "7.2.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@beam/core": "workspace:*",
    "@beam/mcp": "workspace:*",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "zod": "4.4.3"
  }
}
